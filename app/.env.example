# ==============================================================
# PratoCerto — Variáveis de Ambiente (Exemplo)
# ==============================================================
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA versione o arquivo .env ou .env.local no Git.
# ==============================================================

# --------------------------------------------------------------
# Banco de Dados (MySQL)
# --------------------------------------------------------------
# String de conexão com o MySQL.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
# Exemplo local: mysql://root:suasenha@localhost:3306/pratocerto
DATABASE_URL=

# --------------------------------------------------------------
# Autenticação JWT
# --------------------------------------------------------------
# Segredo para assinar tokens JWT de sessão (mínimo de 32 bytes).
# Gere um valor aleatório localmente; nunca use o exemplo abaixo como segredo,
# nunca o compartilhe e nunca o versione em .env/.env.local.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em produção, configure AUTH_SECRET no ambiente de deploy antes de iniciar.
# O fallback local só é ativado por `npm run dev`; outras execuções exigem AUTH_SECRET.
AUTH_SECRET=

# URL base da aplicação (usado para cookies em produção)
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------------------------
# Criação do primeiro gerente (usado apenas pelo script seed:admin)
# Opcional: se não definido, o script gera uma senha aleatória
# --------------------------------------------------------------
# ADMIN_NOME=Gerente Principal
# ADMIN_EMAIL=gerente@pratocerto.com
# ADMIN_SENHA=

# --------------------------------------------------------------
# Ambiente
# --------------------------------------------------------------
NODE_ENV=development
