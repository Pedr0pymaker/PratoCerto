# ==============================================================
# PratoCerto — Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA versione o arquivo .env.local no Git.
# ==============================================================

# --------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# --------------------------------------------------------------
# String de conexão com o PostgreSQL.
# Para uso local: postgresql://usuario:senha@localhost:5432/pratocerto
# Para Vercel + Neon: copie a connection string fornecida pelo Neon.
DATABASE_URL=

# --------------------------------------------------------------
# Autenticação (a ser configurada na Etapa 2)
# --------------------------------------------------------------
# Segredo para assinar tokens de sessão. Use uma string longa e aleatória.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Domínio da aplicação (necessário para cookies de sessão em produção)
# Exemplo: https://pratocerto.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------------------------
# Integrações externas (etapas futuras)
# --------------------------------------------------------------
# Chave de API para OCR de nota fiscal (etapa futura)
# OCR_API_KEY=

# Chave de API para a PratoCerto IA (etapa futura)
# AI_API_KEY=

# --------------------------------------------------------------
# Ambiente
# --------------------------------------------------------------
NODE_ENV=development
