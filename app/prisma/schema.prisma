// =============================================================
// PratoCerto — Schema Prisma
// =============================================================
// ORM: Prisma
// Banco: MySQL 8.0
// Conexão: variável de ambiente DATABASE_URL (nunca hardcoded)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusPedidoCompra {
  PENDENTE
  RECEBIDO
  CANCELADO
}

// -------------------------------------------------------------
// Produto
// Representa um item controlado no estoque do estabelecimento.
// Estoque atual NÃO é armazenado aqui — é calculado a partir
// dos lotes (LoteEstoque) para garantir consistência FIFO.
// -------------------------------------------------------------
model Produto {
  id              String   @id @default(cuid())
  nome            String   @db.VarChar(200)
  categoria       String   @db.VarChar(100)
  unidadeMedida   String   @db.VarChar(50)
  estoqueMinimo   Decimal  @db.Decimal(10, 3)
  estoqueIdeal    Decimal  @db.Decimal(10, 3)
  custoReferencia Decimal? @db.Decimal(10, 2)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  lotes             LoteEstoque[]
  perdas            Perda[]
  itensPedidoCompra ItemPedidoCompra[]

  @@index([ativo])
  @@index([categoria])
  @@map("produtos")
}

// -------------------------------------------------------------
// LoteEstoque
// Cada entrada de estoque gera um lote vinculado a um produto.
// O saldo do produto é calculado pela soma de quantidadeAtual
// de todos os seus lotes — nunca armazenado de forma duplicada.
// -------------------------------------------------------------
model LoteEstoque {
  id                String    @id @default(cuid())
  produtoId         String
  quantidadeInicial Decimal   @db.Decimal(10, 3)
  quantidadeAtual   Decimal   @db.Decimal(10, 3)
  dataEntrada       DateTime
  dataValidade      DateTime?
  custoUnitario     Decimal?  @db.Decimal(10, 2)
  criadoEm          DateTime  @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@index([dataValidade])
  @@map("lotes_estoque")
}

// -------------------------------------------------------------
// Perfil de Acesso do Usuário
// MySQL não tem ENUM nativo como PostgreSQL; o Prisma gerencia
// via String com valores validados na aplicação.
// -------------------------------------------------------------

// -------------------------------------------------------------
// Usuario
// Usuários com acesso ao sistema PratoCerto.
// Senhas armazenadas exclusivamente em hash seguro (bcrypt).
// perfil: "GERENTE" | "FUNCIONARIO"
// -------------------------------------------------------------
model Usuario {
  id           String   @id @default(cuid())
  nome         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  senhaHash    String   @db.VarChar(255)
  perfil       String   @default("FUNCIONARIO") @db.VarChar(20)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  perdas Perda[]

  @@index([email])
  @@index([perfil])
  @@map("usuarios")
}

// -------------------------------------------------------------
// PedidoCompra / ItemPedidoCompra
// Pedido imutável após recebimento/cancelamento; receber gera lotes.
// -------------------------------------------------------------
model PedidoCompra {
  id               String             @id @default(cuid())
  fornecedor       String?            @db.VarChar(200)
  dataPedido       DateTime
  observacoes      String?            @db.VarChar(500)
  status           StatusPedidoCompra @default(PENDENTE)
  total            Decimal            @db.Decimal(12, 2)
  dataRecebimento  DateTime?
  dataCancelamento DateTime?
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt

  itens ItemPedidoCompra[]

  @@index([status, dataPedido])
  @@index([dataPedido])
  @@map("pedidos_compra")
}

model ItemPedidoCompra {
  id            String    @id @default(cuid())
  pedidoId      String
  produtoId     String
  quantidade    Decimal   @db.Decimal(10, 3)
  custoUnitario Decimal   @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(12, 2)
  dataValidade  DateTime?

  pedido  PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto      @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido_compra")
}

// -------------------------------------------------------------
// Perda
// Registro de desperdício de estoque. A quantidade perdida é
// descontada dos lotes via FIFO (mais antigos primeiro) no
// momento do registro, dentro de uma transação atômica.
// motivo: "VENCIMENTO" | "DETERIORACAO" | "SOBRA" | "PREPARO_ACIDENTE" | "OUTRO"
// -------------------------------------------------------------
model Perda {
  id            String   @id @default(cuid())
  produtoId     String
  usuarioId     String
  quantidade    Decimal  @db.Decimal(10, 3)
  motivo        String   @db.VarChar(30)
  custoEstimado Decimal  @db.Decimal(10, 2)
  observacao    String?  @db.VarChar(500)
  dataHora      DateTime @default(now())
  criadoEm      DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@index([usuarioId])
  @@index([motivo])
  @@index([dataHora])
  @@map("perdas")
}
